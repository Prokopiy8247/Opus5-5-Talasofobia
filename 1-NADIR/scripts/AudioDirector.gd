extends Node
## NADIR audio director: buses and effects, the depth-driven ambience mix, the breathing loop, pressure
## creaks and hull groans, the Bloop. Lead: var ad = load("res://scripts/AudioDirector.gd").new()
## add_child(ad); ad.setup(); then ad.update(depth_m, delta) every frame (positive metres).
## Sounds come from res://assets/audio/ (generated by Tools/gen_audio.py, files peak at -3 dBFS).

const DIR := "res://assets/audio/"
const BREATH_CYCLE := 4.5            # s per breath in breath_loop.wav (3 cycles = 13.5 s), inhale at 0
const FADE_IN_S := 2.5               # ambience + breathing fade in with the picture

# Levels, dB on top of the files.
const VOL_SURFACE := -12.0
const VOL_WATER := -13.0
const VOL_DEEP := -12.0
const VOL_RUSH := -6.0
const VOL_LAMP := -26.0
const VOL_BREATH := -3.0
const VOL_CLICK := -6.0
const VOL_RELEASE := -4.0
const VOL_CREAK := -2.0
const VOL_GROAN := -2.0
const VOL_BLOOP := 0.0
const VOL_BLOOP_SUB := -4.0
const DUCK_DB := -14.0               # near-silence of beat 4 (everything but breathing)
const PAUSE_DB := -14.0
const LIMIT_CEILING_DB := -1.0

# Depth plan, positive metres.
const SURFACE_OUT := 60.0                        # surface_loop fades out over 0..60
const DEEP_IN := Vector2(150.0, 420.0)           # deep_loop fades in
const DEEP_THIN := Vector2(1440.0, 1530.0)       # drone thins at the end: only water + breathing
const CREAK_ZONE := Vector2(320.0, 760.0)
const CREAK_GAP := Vector2(9.0, 20.0)            # s between creaks
const GROAN_GAP := Vector2(20.0, 32.0)           # s between hull groans
const CREAK_DIST := 40.0                         # m to +Z of the camera (also their unit_size)
const GROAN_DIST := 150.0
const SILENCE := Vector4(725.0, 745.0, 950.0, 962.0)  # duck ramps in x..y, holds, restores z..w
const LAMP_IN := Vector2(1530.0, 1560.0)
const LP_SURFACE_HZ := 6000.0
const LP_DEEP_HZ := 900.0
const LP_DEPTH := 1100.0                         # depth where the ambience low-pass reaches LP_DEEP_HZ
const REVERB_DEPTH := 900.0                      # depth where the reverb is at its largest
const BREATH_PITCH_DEEP := 0.9                   # breath pitch_scale at 1500 m (slower, heavier)
const BLOOP_UNIT := 260.0                        # Bloop unit_size: 0 dB at 260 m

var _ok := false
var _depth := 0.0
var _fade := 0.0
var _end := 1.0
var _end_rate := 0.0
var _paused := false
var _pause_db := 0.0
var _duck_db := 0.0
var _rush := 0.0
var _rush_target := 0.0
var _breath_gain := 1.0
var _breath_target := 1.0
var _breath_rate := 1.0
var _breath_stopping := false
var _phase := 0.0
var _latency := 0.0
var _in_zone := false
var _next_creak := 0.0
var _next_groan := 0.0
var _last_creak := -1
var _last_groan := -1
var _bloop_last := 0

var _bus_amb := -1
var _bus_sfx := -1
var _bus_breath := -1
var _bus_evt := -1                 # one-off story events: never ducked by the B4 silence
var _lp_evt: AudioEffectLowPassFilter
var _rv_evt: AudioEffectReverb
var _settle: AudioStreamPlayer3D
var _clunk: AudioStreamPlayer3D
var _lp_amb: AudioEffectLowPassFilter
var _lp_sfx: AudioEffectLowPassFilter
var _lp_breath: AudioEffectLowPassFilter
var _rv_amb: AudioEffectReverb
var _rv_sfx: AudioEffectReverb

var _surface: AudioStreamPlayer
var _water: AudioStreamPlayer
var _deep: AudioStreamPlayer
var _rush_p: AudioStreamPlayer
var _lamp: AudioStreamPlayer
var _breath: AudioStreamPlayer
var _click: AudioStreamPlayer
var _release: AudioStreamPlayer
var _bloop_sub: AudioStreamPlayer
var _pool: Array[AudioStreamPlayer3D] = []
var _pool_i := 0
var _bloop3d: Array[AudioStreamPlayer3D] = []
var _creaks: Array[AudioStream] = []
var _groans: Array[AudioStream] = []
var _bloops: Array[AudioStream] = []
var _bloop_subs: Array[AudioStream] = []
var _pausable: Array[Node] = []


# ------------------------------------------------------------------ public API
func setup() -> void:
	if _ok:
		return
	process_mode = Node.PROCESS_MODE_ALWAYS
	_make_buses()
	_surface = _player("surface_loop", &"Ambience", true)
	_water = _player("water_loop", &"Ambience", true)
	_deep = _player("deep_loop", &"Ambience", true)
	_rush_p = _player("bloop_rush_loop", &"Ambience", true)
	_lamp = _player("lamp_hum_loop", &"Ambience", true)
	_breath = _player("breath_loop", &"Breath", false)
	_click = _player("torch_click", &"Breath", false)
	_release = _player("release", &"SFX", false)
	_bloop_sub = _player("", &"SFX", false)
	for _i in 5:
		_pool.append(_player3d())
	for _i in 2:
		_bloop3d.append(_player3d())
	_settle = _player3d()
	_settle.bus = &"Event"
	_clunk = _player3d()
	_clunk.bus = &"Event"
	for i in range(1, 5):
		_creaks.append(_load("creak_%d" % i))
	for i in range(1, 4):
		_groans.append(_load("hull_groan_%d" % i))
	for i in range(1, 3):
		_bloops.append(_load("bloop_groan_%d" % i))
		_bloop_subs.append(_load("bloop_groan_%d_sub" % i))
	_latency = AudioServer.get_output_latency()
	var g := get_node_or_null(^"/root/G")
	if g != null and g.get("audio") == null:
		g.set("audio", self)
	_ok = true
	_apply(0.0)
	if _breath.stream != null:
		_breath.play()


func update(depth: float, delta: float) -> void:
	_depth = depth
	if not _ok or _paused:
		return
	var inside := depth >= CREAK_ZONE.x and depth <= CREAK_ZONE.y
	if inside and not _in_zone:
		_next_creak = randf_range(2.0, 5.0)
		_next_groan = randf_range(8.0, 14.0)
	_in_zone = inside
	if not inside:
		return
	_next_creak -= delta
	_next_groan -= delta
	if _next_creak <= 0.0:
		_next_creak = randf_range(CREAK_GAP.x, CREAK_GAP.y)
		_last_creak = _pick(_creaks.size(), _last_creak)
		_one_shot(_creaks[_last_creak], CREAK_DIST,
			Vector3(randf_range(-18.0, 18.0), randf_range(-14.0, 10.0), randf_range(-8.0, 8.0)),
			VOL_CREAK + randf_range(-3.0, 1.0), randf_range(0.82, 1.12))
	if _next_groan <= 0.0:
		_next_groan = randf_range(GROAN_GAP.x, GROAN_GAP.y)
		_last_groan = _pick(_groans.size(), _last_groan)
		_one_shot(_groans[_last_groan], GROAN_DIST,
			Vector3(randf_range(-60.0, 60.0), randf_range(-80.0, 20.0), randf_range(-30.0, 30.0)),
			VOL_GROAN + randf_range(-2.0, 1.0), randf_range(0.85, 1.08))


func play_release() -> void:
	if _ok and _release.stream != null:
		_release.volume_db = VOL_RELEASE
		_release.play()


func play_torch_click() -> void:
	if _ok and _click.stream != null:
		_click.volume_db = VOL_CLICK
		_click.pitch_scale = randf_range(0.96, 1.04)
		_click.play()


## index 1 = the first groan (heard ~15 s before the creature is seen), 2 = as the tail leaves.
func bloop_groan(index: int, world_pos: Vector3) -> void:
	if not _ok:
		return
	var i := clampi(index, 1, 2) - 1
	_bloop_last = i
	var p := _bloop3d[i]
	p.stream = _bloops[i]
	p.unit_size = BLOOP_UNIT
	p.max_db = 6.0
	p.volume_db = VOL_BLOOP
	p.attenuation_filter_db = 0.0
	p.pitch_scale = 1.0
	p.global_position = world_pos
	p.play()
	_bloop_sub.stream = _bloop_subs[i]
	_bloop_sub.volume_db = VOL_BLOOP_SUB
	_bloop_sub.play()


## Optional: move the most recent Bloop groan with the creature.
func set_bloop_position(world_pos: Vector3) -> void:
	if _ok:
		_bloop3d[_bloop_last].global_position = world_pos


## Hook (ship, B4): the sunken hull settles overhead, one deep groan heard through the silence.
func hull_settle(pos: Vector3) -> void:
	if not _ok or _groans.is_empty():
		return
	_last_groan = _pick(_groans.size(), _last_groan)
	_settle.stream = _groans[_last_groan]
	_settle.unit_size = 70.0
	_settle.max_db = 6.0
	_settle.volume_db = VOL_GROAN + 3.0
	_settle.pitch_scale = 0.62
	_settle.global_position = pos
	_settle.play()


## Hook (B6): a heavy relay closing somewhere at the lamp field (the torch-click sample, pitched down).
func relay_clunk(pos: Vector3) -> void:
	if not _ok or _click.stream == null:
		return
	_clunk.stream = _click.stream
	_clunk.unit_size = 20.0
	_clunk.volume_db = -4.0
	_clunk.pitch_scale = 0.45
	_clunk.global_position = pos
	_clunk.play()


func set_bloop_rush(amount: float) -> void:
	_rush_target = clampf(amount, 0.0, 1.0)


func stop_breathing(fade_s: float = 1.0) -> void:
	_breath_target = 0.0
	_breath_rate = 1.0 / maxf(fade_s, 0.02)
	_breath_stopping = true


func set_paused(p: bool) -> void:
	_paused = p
	for n in _pausable:
		n.set("stream_paused", p)


func fade_out_all(seconds: float = 3.0) -> void:
	_end_rate = 1.0 / maxf(seconds, 0.02)


## 0..1 within the current 4.5 s breath (0 = inhale starts), from the breath player's position.
func get_breath_phase() -> float:
	if _ok and not _paused and _breath.playing:
		var pos := _breath.get_playback_position() \
			+ (AudioServer.get_time_since_last_mix() - _latency) * _breath.pitch_scale
		_phase = fposmod(pos, BREATH_CYCLE) / BREATH_CYCLE
	return _phase


## 0..1 loudness of the breathing (fade-in, stop_breathing): scale the breathing sway by it.
func get_breath_level() -> float:
	return _breath_gain * smoothstep(0.0, 1.0, _fade) if _ok and _breath.playing else 0.0


# ------------------------------------------------------------------ mix
func _process(delta: float) -> void:
	if not _ok:
		return
	_pause_db = move_toward(_pause_db, PAUSE_DB if _paused else 0.0, delta * 28.0)
	if _end_rate > 0.0:
		_end = maxf(_end - delta * _end_rate, 0.0)
	AudioServer.set_bus_volume_db(0, _pause_db + _db(_end * _end))
	if not _paused:
		_apply(delta)


func _apply(delta: float) -> void:
	var d := _depth
	_fade = minf(_fade + delta / FADE_IN_S, 1.0)
	var fi := smoothstep(0.0, 1.0, _fade)
	_duck_db = move_toward(_duck_db, _duck_target(d), delta * 5.0)
	AudioServer.set_bus_volume_db(_bus_amb, _duck_db + _db(fi))
	AudioServer.set_bus_volume_db(_bus_sfx, _duck_db)
	var cut := LP_SURFACE_HZ * pow(LP_DEEP_HZ / LP_SURFACE_HZ, clampf(d / LP_DEPTH, 0.0, 1.0))
	_lp_amb.cutoff_hz = cut
	_lp_sfx.cutoff_hz = cut * 1.6
	_lp_evt.cutoff_hz = cut * 1.6
	var kr := smoothstep(0.0, REVERB_DEPTH, d)
	_set_reverb(_rv_amb, kr, 0.12, 0.40)
	_set_reverb(_rv_sfx, kr, 0.20, 0.55)
	_set_reverb(_rv_evt, kr, 0.20, 0.55)
	# breathing: always on, slower and heavier with depth
	var kb := clampf(d / 1500.0, 0.0, 1.0)
	_breath.pitch_scale = lerpf(1.0, BREATH_PITCH_DEEP, kb)
	_lp_breath.cutoff_hz = lerpf(9000.0, 5000.0, kb)
	_breath_gain = move_toward(_breath_gain, _breath_target, delta * _breath_rate)
	_breath.volume_db = VOL_BREATH + 1.5 * kb + _db(_breath_gain * fi)
	if _breath_stopping and _breath_gain <= 0.0 and _breath.playing:
		_breath.stop()
	# ambience beds
	_bed(_surface, VOL_SURFACE, 1.0 - smoothstep(0.0, SURFACE_OUT, d))
	_bed(_water, VOL_WATER, lerpf(0.7, 1.0, smoothstep(0.0, 90.0, d)))
	_water.pitch_scale = lerpf(1.0, 0.8, clampf(d / 1200.0, 0.0, 1.0))
	_bed(_deep, VOL_DEEP, smoothstep(DEEP_IN.x, DEEP_IN.y, d)
		* lerpf(1.0, 0.3, smoothstep(DEEP_THIN.x, DEEP_THIN.y, d)))
	_rush = move_toward(_rush, _rush_target, delta * 0.35)
	_bed(_rush_p, VOL_RUSH, _rush)
	_bed(_lamp, VOL_LAMP, smoothstep(LAMP_IN.x, LAMP_IN.y, d))


func _duck_target(d: float) -> float:
	return DUCK_DB * smoothstep(SILENCE.x, SILENCE.y, d) * (1.0 - smoothstep(SILENCE.z, SILENCE.w, d))


func _set_reverb(r: AudioEffectReverb, k: float, wet0: float, wet1: float) -> void:
	r.room_size = lerpf(0.35, 0.95, k)
	r.damping = lerpf(0.45, 0.72, k)
	r.wet = lerpf(wet0, wet1, k)
	r.dry = lerpf(1.0, 0.85, k)
	r.predelay_msec = lerpf(25.0, 140.0, k)
	r.predelay_feedback = lerpf(0.2, 0.45, k)


func _bed(p: AudioStreamPlayer, base_db: float, g: float) -> void:
	if p.stream == null:
		return
	if g <= 0.001:
		if p.playing:
			p.stop()
		return
	p.volume_db = base_db + _db(g)
	if not p.playing:
		p.play()


func _db(g: float) -> float:
	return linear_to_db(maxf(g, 0.0001))


# ------------------------------------------------------------------ one-shots
func _pick(n: int, last: int) -> int:
	if n <= 1:
		return 0
	var i := randi() % n
	return (i + 1) % n if i == last else i


func _one_shot(s: AudioStream, dist: float, off: Vector3, vol: float, pitch: float) -> void:
	if s == null:
		return
	var p := _free_3d()
	p.stream = s
	p.unit_size = dist
	p.volume_db = vol
	p.pitch_scale = pitch
	p.global_position = _cam_pos() + Vector3(off.x, off.y, dist + off.z)
	p.play()


func _free_3d() -> AudioStreamPlayer3D:
	for p in _pool:
		if not p.playing:
			return p
	_pool_i = (_pool_i + 1) % _pool.size()
	return _pool[_pool_i]


func _cam_pos() -> Vector3:
	var g := get_node_or_null(^"/root/G")
	var cam = g.get("camera") if g != null else null
	if cam != null and is_instance_valid(cam) and (cam as Node3D).is_inside_tree():
		return (cam as Node3D).global_position
	return Vector3(0.0, -_depth, 0.0)


# ------------------------------------------------------------------ construction
func _load(n: String) -> AudioStream:
	var s := load(DIR + n + ".wav") as AudioStream
	if s == null:
		push_warning("AudioDirector: missing " + n)
		return null
	var w := s as AudioStreamWAV
	if w != null and n.ends_with("_loop"):
		var frames := int(round(w.get_length() * w.mix_rate))
		if w.loop_mode == AudioStreamWAV.LOOP_DISABLED or w.loop_end <= w.loop_begin or w.loop_end > frames:
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = 0
			w.loop_end = frames
	return s


func _player(n: String, bus: StringName, always: bool) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	if n != "":
		p.stream = _load(n)
	p.bus = bus
	p.volume_db = -80.0
	p.process_mode = Node.PROCESS_MODE_ALWAYS if always else Node.PROCESS_MODE_PAUSABLE
	add_child(p)
	if not always:
		_pausable.append(p)
	return p


func _player3d() -> AudioStreamPlayer3D:
	var p := AudioStreamPlayer3D.new()
	p.bus = &"SFX"
	p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
	p.unit_size = CREAK_DIST
	p.max_db = 3.0
	p.max_distance = 0.0
	p.panning_strength = 0.8
	p.attenuation_filter_cutoff_hz = 4000.0
	p.attenuation_filter_db = -10.0
	p.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
	p.process_mode = Node.PROCESS_MODE_PAUSABLE
	add_child(p)
	_pausable.append(p)
	return p


func _make_buses() -> void:
	if _find_fx(0, "AudioEffectHardLimiter") == null:
		var lim := AudioEffectHardLimiter.new()
		lim.ceiling_db = LIMIT_CEILING_DB
		lim.release = 0.12
		AudioServer.add_bus_effect(0, lim)
	_bus_amb = _bus("Ambience")
	_bus_sfx = _bus("SFX")
	_bus_breath = _bus("Breath")
	_lp_amb = _lowpass(_bus_amb)
	_lp_sfx = _lowpass(_bus_sfx)
	_lp_breath = _lowpass(_bus_breath)
	_rv_amb = _reverb(_bus_amb)
	_rv_sfx = _reverb(_bus_sfx)
	_bus_evt = _bus("Event")
	_lp_evt = _lowpass(_bus_evt)
	_rv_evt = _reverb(_bus_evt)
	var rb := _reverb(_bus_breath)              # close and nearly dry: just the mask and hood
	rb.room_size = 0.25
	rb.damping = 0.6
	rb.wet = 0.06
	rb.dry = 1.0
	rb.predelay_msec = 8.0
	rb.spread = 0.6


func _bus(n: String) -> int:
	var i := AudioServer.get_bus_index(n)
	if i < 0:
		AudioServer.add_bus()
		i = AudioServer.bus_count - 1
		AudioServer.set_bus_name(i, n)
	AudioServer.set_bus_send(i, &"Master")
	return i


func _find_fx(bus: int, cls: String) -> AudioEffect:
	for k in AudioServer.get_bus_effect_count(bus):
		var e := AudioServer.get_bus_effect(bus, k)
		if e != null and e.get_class() == cls:
			return e
	return null


func _lowpass(bus: int) -> AudioEffectLowPassFilter:
	var e := _find_fx(bus, "AudioEffectLowPassFilter") as AudioEffectLowPassFilter
	if e == null:
		e = AudioEffectLowPassFilter.new()
		e.resonance = 0.5
		e.db = AudioEffectFilter.FILTER_12DB
		AudioServer.add_bus_effect(bus, e)
	return e


func _reverb(bus: int) -> AudioEffectReverb:
	var e := _find_fx(bus, "AudioEffectReverb") as AudioEffectReverb
	if e == null:
		e = AudioEffectReverb.new()
		e.spread = 0.85
		e.hipass = 0.05
		AudioServer.add_bus_effect(bus, e)
	return e
