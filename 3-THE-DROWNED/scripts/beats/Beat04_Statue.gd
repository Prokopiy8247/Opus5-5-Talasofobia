func build(parent: Node3D) -> void:
	var st := Statue.build(parent, O, 0.0) as MeshInstance3D
	var stone := st.material_override as ShaderMaterial
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--head-test="):
			stone.set_shader_parameter("head_override", float(a.get_slice("=", 1)))
	var palm := Statue.world_point(Statue.PALM_CENTER, O, 0.0)
	# the offering: a liner wreck cradled in the palm (no rudder or propellers under the keel); "wreck" breaks
	# only what stands above the deck, so the hull below it still fits the palm (palm_fit.py)
	# no sun shadows from it: the tiered superstructure threw hard stepped slabs onto the palm (the contact is
	# darkened by the keel term in stone.gdshader and the silt banks); test: --palm-shadows turns them back on
	var shadows := "--palm-shadows" in OS.get_cmdline_user_args()
	var liner := Hull.ship("liner", LINER_LEN, 404, {"fittings": false, "wreck": true, "shadows": shadows})
	var b := Basis(LINER_BASIS[0], LINER_BASIS[1], LINER_BASIS[2]).orthonormalized()
	liner.transform = Transform3D(b, Statue.world_point(LINER_POS, O, 0.0))
	parent.add_child(liner)
	# contact shadow on the palm around the keel
	stone.set_shader_parameter("keel_a", Statue.world_point(LINER_KEEL[0], O, 0.0))
	stone.set_shader_parameter("keel_b", Statue.world_point(LINER_KEEL[1], O, 0.0))
	stone.set_shader_parameter("keel_r", float(liner.get_meta("beam", LINER_LEN * 0.117)) * 0.5)
	_skirt(st, stone)
	# a small wreck lying by the right hand: the finger is as big as a ship
	var rh := Statue.world_point(Statue.RIGHT_HAND, O, 0.0)
	var tr := Hull.ship("trawler", 40.0, 77)
	var tp := rh + Vector3(-95.0, 0.0, 40.0)
	tp.y = Terrain.height(tp.x, tp.z) - 2.0
	tr.position = tp
	tr.rotation = Vector3(deg_to_rad(-12.0), deg_to_rad(35.0), deg_to_rad(18.0))
	parent.add_child(tr)
	_chain(parent)
	print("statue: face %s palm %s liner %.0f m" % [Statue.world_point(Statue.FACE_CENTER, O, 0.0), palm, LINER_LEN])


## Silt bedded along the keel, one continuous bank down each side of the hull: from just inside the hull,
## over a low shoulder, down onto the stone (stone material with COLOR.g = 1: the shader paints it as the
## silt mantle, and the palm around the keel gets the same silt, so the bank has no visible edge).
## palm_fit.py leaves stations empty where the hull side stands high over the stone; those are filled here
## (pins along the hull, the stone found by a ray down the statue mesh) as a wider, sloping bank, and both
## ends of a bank sink into the stone instead of ending in a cut face. Test: --palm-skirt=0 hides it.
func _skirt(st: MeshInstance3D, stone: ShaderMaterial) -> void:
	if SKIRT.is_empty():
		return
	for a in OS.get_cmdline_user_args():
		if a == "--palm-skirt=0":
			return
	var tm := st.mesh.generate_triangle_mesh()
	var stone_arrays := st.mesh.surface_get_arrays(0) if st.mesh.get_surface_count() == 1 else []
	var side_x := (LINER_BASIS[0] as Vector3).normalized()
	var half := SKIRT.size() / 2
	var mb := MeshBuilder.new()
	var filled := 0
	for side in 2:
		var ents: Array = SKIRT.slice(side * half, (side + 1) * half)
		var out := side_x * (1.0 if side == 0 else -1.0)
		var valid := []
		for i in ents.size():
			if not (ents[i] as Array).is_empty():
				valid.append(i)
		if valid.size() < 2:
			continue
		var rows := []
		for i in range(valid[0], int(valid[valid.size() - 1]) + 1):
			var e: Array = ents[i]
			if not e.is_empty():
				rows.append([e[0], e[1], e[2]])
				continue
			# a gap: the pin by interpolation along the hull side, the stone by a ray straight down
			var a := 0
			var b := 0
			for k: int in valid:
				if k < i:
					a = k
				elif b == 0 or k < b:
					b = k
					break
			var pin: Vector3 = (ents[a][0] as Vector3).lerp(ents[b][0], float(i - a) / float(b - a))
			var wl := pin + out * 0.5 + Vector3.UP * 0.6           # the hull side at the contact waterline
			var s_mid := _surf_below(tm, wl + out * 2.2)
			if s_mid == Vector3.INF:
				rows.append([])
				continue
			# the higher the hull stands over the stone, the wider and lower the bank
			var drop := maxf(wl.y - s_mid.y - 0.9, 0.0)
			s_mid = _surf_below(tm, wl + out * (2.2 + drop * 0.6))
			var s_out := _surf_below(tm, wl + out * (5.5 + drop * 1.1))
			if s_mid == Vector3.INF or s_out == Vector3.INF:
				rows.append([])
				continue
			rows.append([pin, s_mid + Vector3.UP * 0.9, s_out - Vector3.UP * 0.35])
			filled += 1
		# split at stations the rays could not fill, then build each bank
		var run := []
		for r: Array in rows + [[]]:
			if not r.is_empty():
				run.append(r)
				continue
			if run.size() > 2:
				_bank(mb, run, tm, stone_arrays)
			run = []
	var mi := mb.instance(stone, st)
	mi.name = "PalmSilt"
	# the statue's rim and key lights reach only render layer 2 (Main._statue_rim sets it on the statue alone):
	# without it the banks stay unlit and read as a dark slab shaped like the hull beside the lit stone
	mi.layers = 1 | 2
	print("statue: palm silt banks, %d gap stations filled" % filled)


## One silt bank from rows [pin, mid, outer]; the first and last rows are sunk into the stone (taper).
## Its outer rows take the normal and the baked AO of the stone they sink into, so the line where the bank
## meets the palm does not show as a straight lit edge (a pale cut-out patch under the hull).
func _bank(mb: MeshBuilder, run: Array, tm: TriangleMesh, stone_arrays: Array) -> void:
	var rows := []
	for i in run.size():
		var e: Array = run[i]
		var pin: Vector3 = e[0]
		var mid: Vector3 = e[1]
		var outp: Vector3 = e[2]
		var shoulder := pin.lerp(mid, 0.55) + Vector3(0, 0.35, 0)
		var lip := mid.lerp(outp, 0.6) + Vector3(0, 0.1, 0)
		if i == 0 or i == run.size() - 1:
			# the end row lies under the stone: the bank thins out instead of ending in a cut face
			mid = mid - Vector3.UP * 1.3
			shoulder = pin.lerp(mid, 0.55) - Vector3.UP * 0.6
			lip = mid.lerp(outp, 0.6) - Vector3.UP * 0.6
			outp = outp - Vector3.UP * 0.5
		rows.append(PackedVector3Array([pin, shoulder, mid, lip, outp]))
	var base := mb.v.size()
	# only the part tucked under the hull is darker; the keel contact shadow in stone.gdshader does the rest
	var ao := [0.55, 0.82, 0.95, 1.0, 1.0]
	for i in rows.size():
		var row: PackedVector3Array = rows[i]
		for j in row.size():
			mb.vert(row[j], Vector3.UP, Vector2(float(i), float(j)), Color(ao[j], 1.0, 0.0, 1.0))
	for i in rows.size() - 1:
		for j in 4:
			var a := base + i * 5 + j
			mb.quad(a, a + 5, a + 6, a + 1)
	# normals from the strip
	for i in rows.size():
		for j in 5:
			var k := base + i * 5 + j
			var du: Vector3 = mb.v[base + mini(i + 1, rows.size() - 1) * 5 + j] - mb.v[base + maxi(i - 1, 0) * 5 + j]
			var dv: Vector3 = mb.v[base + i * 5 + mini(j + 1, 4)] - mb.v[base + i * 5 + maxi(j - 1, 0)]
			var nn := du.cross(dv).normalized()
			if nn.y < 0.0:
				nn = -nn
			mb.n[k] = nn
	# blend the outer rows (mid, lip, outer edge) into the stone below them
	var blend := [0.0, 0.0, 0.5, 0.85, 1.0]
	for i in rows.size():
		for j in range(2, 5):
			var k := base + i * 5 + j
			var sa := _stone_at(tm, stone_arrays, mb.v[k])
			if sa.is_empty():
				continue
			mb.n[k] = mb.n[k].lerp(sa[0], blend[j]).normalized()
			var c := mb.col[k]
			c.r = lerpf(c.r, sa[1], blend[j])
			mb.col[k] = c


## The stone straight below p (statue-local): [smooth normal, baked AO] averaged over a few rays around p
## (vertex normals and COLOR.r of the hit triangles), or [] when nothing is hit.
static func _stone_at(tm: TriangleMesh, arrays: Array, p: Vector3) -> Array:
	var nsum := Vector3.ZERO
	var ao := 0.0
	var hits := 0
	var has_attr := arrays.size() > Mesh.ARRAY_INDEX and arrays[Mesh.ARRAY_INDEX] != null \
		and arrays[Mesh.ARRAY_NORMAL] != null and arrays[Mesh.ARRAY_COLOR] != null
	for o: Vector3 in [Vector3.ZERO, Vector3(1.5, 0, 0), Vector3(-1.5, 0, 0), Vector3(0, 0, 1.5), Vector3(0, 0, -1.5)]:
		var hit := tm.intersect_ray(p + o + Vector3.UP * 3.0, Vector3.DOWN)
		if hit.is_empty() or (p + o).y - (hit["position"] as Vector3).y > 6.0:
			continue
		var nn: Vector3 = hit["normal"]
		var a := 1.0
		var fi: int = hit.get("face_index", -1)
		if has_attr and fi >= 0:
			var ix: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
			if fi * 3 + 2 < ix.size():
				var vs: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
				var ns: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL]
				var cs: PackedColorArray = arrays[Mesh.ARRAY_COLOR]
				var i0 := ix[fi * 3]
				var i1 := ix[fi * 3 + 1]
				var i2 := ix[fi * 3 + 2]
				# only if the index really is the hit triangle (one surface, same order)
				var q: Vector3 = hit["position"]
				var b := Geometry3D.get_triangle_barycentric_coords(q, vs[i0], vs[i1], vs[i2])
				if b != Vector3.ZERO and b.x > -0.05 and b.y > -0.05 and b.z > -0.05:
					nn = (ns[i0] * b.x + ns[i1] * b.y + ns[i2] * b.z).normalized()
					a = cs[i0].r * b.x + cs[i1].r * b.y + cs[i2].r * b.z
		nsum += nn if nn.y >= 0.0 else -nn
		ao += a
		hits += 1
	if hits == 0:
		return []
	return [nsum.normalized(), ao / float(hits)]


## First stone surface point straight below p (statue-local; from 3 m above, 14 m down), or Vector3.INF.
static func _surf_below(tm: TriangleMesh, p: Vector3) -> Vector3:
	var hit := tm.intersect_ray(p + Vector3.UP * 3.0, Vector3.DOWN)
	if hit.is_empty():
		return Vector3.INF
	var q: Vector3 = hit["position"]
	return q if p.y - q.y < 14.0 else Vector3.INF


## The anchor chain: from the bow hawse down onto the palm, over the edge of the hand (CHAIN, from
## palm_fit.py) and straight down to the seabed below, a few links trailing downhill.
func _chain(parent: Node3D) -> void:
	if CHAIN.is_empty():
		return
	var pts := PackedVector3Array()
	for p: Vector3 in CHAIN:
		pts.append(Statue.world_point(p, O, 0.0))
	var edge := pts[pts.size() - 1]
	var prev := pts[maxi(pts.size() - 2, 0)]
	var out := Vector3(edge.x - prev.x, 0.0, edge.z - prev.z).normalized()
	var gy := Terrain.height(edge.x, edge.z)
	var drop := edge.y - gy
	# hang: leave the edge with a short lip, then nearly vertical, drifting a little outward and bellied a few
	# metres sideways by the current (a dead-straight line read as a string)
	var n := maxi(int(drop / 2.0), 6)
	var side := Vector3(out.z, 0.0, -out.x)
	for i in range(1, n + 1):
		var t := float(i) / float(n)
		var q := edge + out * (2.5 * sqrt(t) + 3.0 * t) + side * (sin(t * PI) * 4.0 + sin(t * PI * 3.0) * 0.8) \
			+ Vector3(0, -drop * t, 0)
		q.y = maxf(q.y, Terrain.height(q.x, q.z) + 0.5)
		pts.append(q)
	# trail downhill on the seabed
	var last := pts[pts.size() - 1]
	var dh := Vector3(0, 0, -1).lerp(out, 0.4).normalized()
	for i in range(1, 12):
		var q := last + dh * 2.2 * float(i) + Vector3(dh.z, 0, -dh.x) * sin(float(i) * 0.6) * 1.2
		q.y = Terrain.height(q.x, q.z) + 0.5
		pts.append(q)
	# rusted iron, not red string: brown links, light enough to read against the dark water under the hand,
	# with orange rust blooms and dark iron that change from link to link (fine noise) and a little moss on
	# top; links as big as the liner chain of beat 2, so the alternating wide/narrow links bead the outline
	var mat := Mats.solid(Palette.STEEL_DARK.lerp(Palette.RUST, 0.55).lightened(0.15), 0.7, 0.25, {"noise_scale": 0.35})
	Chain.chain(pts, 1.4, parent, 900.0, mat).name = "PalmChain"
